# Local Vite development reads .env.local. Set one pair of public endpoints
# to enable cloud login. Leave both providers empty to run the local-only app.
# Public build configuration, also required by the production Node server.
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Production process environment / Render Environment settings.
# npm start does not load .env.local automatically. Never put secrets in VITE_*.
APP_ORIGIN=https://english.lomivex.top
NEON_DATABASE_URL=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
SUPABASE_SECRET_KEY=
DEEPSEEK_API_KEY=
# Beijing-region Alibaba Cloud Model Studio credentials; server only.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# Optional seed-import URL; defaults to VITE_SUPABASE_URL.
SUPABASE_URL=
# PORT is provided by Render; omit it there.
# Never commit real values or include .env.local in a share bundle.
